---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { asset } from '../lib/images';
import homeCard from '../assets/home/home_card.webp';
import infoCard from '../assets/home/info_card.webp';
const photos: Record<string, ImageMetadata> = { 'home_card.webp': homeCard, 'info_card.webp': infoCard };
import motionMachine from '../assets/home/motionMachine.png';
import motionReel1 from '../assets/home/reel1.png';
import motionReel2 from '../assets/home/reel2.png';

const graphicsLayers = [
    { image: 'cover_bottom_yellow.png', depth: 0.55, layer: 'bottom', bounds: '0.0755,0.138,0.2641,0.417', shadow: 'rgba(121, 101, 0, 0.22)' },
    { image: 'cover_bottom_red.png', depth: 0.6, layer: 'bottom', bounds: '0.4177,0.5852,0.251,0.312', shadow: 'rgba(125, 28, 33, 0.2)' },
    { image: 'cover_bottom_blue.png', depth: 0.65, layer: 'bottom', bounds: '0.4161,0.1361,0.2443,0.3593', shadow: 'rgba(0, 95, 116, 0.22)' },
    { image: 'cover_purple.png', depth: 0.8, layer: 'middle', bounds: '0.7625,0.138,0.1703,0.0491', shadow: 'rgba(83, 44, 119, 0.2)' },
    { image: 'cover_green.png', depth: 0.85, layer: 'middle', bounds: '0.7625,0.5852,0.175,0.312', shadow: 'rgba(20, 95, 36, 0.2)' },
    { image: 'cover_top_purple.png', depth: 1, layer: 'top', bounds: '0.0766,0.5167,0.5141,0.1213', shadow: 'rgba(83, 44, 119, 0.2)' },
    { image: 'cover_top_pink.png', depth: 1.1, layer: 'top', bounds: '0.6286,0.137,0.0927,0.3583', shadow: 'rgba(132, 31, 65, 0.2)' },
];

const tiles = [
    { href: '/', label: 'Oliver Makeham', kind: 'photo', file: 'home_card.webp' },
    { href: '/game', label: 'Interactive Realtime Environment', kind: 'bar' },
    { href: '/swaplings', label: 'Swaplings', kind: 'card', subjectBounds: '0.2492,0.0635,0.5053,0.8913' },
    { href: '/maps', label: 'Maps', kind: 'maps' },
    { href: '/animation', label: 'Short Animation', kind: 'fade' },
    { href: '/presents', label: 'Presents for Friends', kind: 'presents' },
    { href: '/callan', label: 'Graphic Wayfinding Concept', kind: 'mesh' },
    { href: '/graphics', label: 'Graphic Exhibition Concept', kind: 'layers' },
    { href: '/bar', label: 'Bar', kind: 'bar' },
    { href: '/assortments', label: 'Assortments', kind: 'robot' },
    { href: '/about', label: 'Info', kind: 'photo', file: 'info_card.webp' },
    { href: '#motion', label: 'Disable motion', kind: 'motion' },
];

// Shared responsive settings: cards are at most ~480px wide in a 3 column grid
const cardSizes = '(max-width: 560px) 100vw, (max-width: 960px) 50vw, 480px';
const card = {
    widths: [640, 960, 1280],
    sizes: cardSizes,
    format: 'webp' as const,
    quality: 78,
    decoding: 'async' as const,
};

const presentsSubject = await getImage({
    src: asset('jpg_presents', 'coverSubject.png'),
    width: 960,
    format: 'webp',
    quality: 80,
});
const presentsDisc = await getImage({ src: asset('jpg_presents', 'revealDisc.png'), format: 'png' });
const callanSubject = await getImage({
    src: asset('jpg_callan', 'coverSubject.png'),
    width: 1200,
    format: 'webp',
    quality: 80,
});

const swaplingsSubject = asset('jpg_swaplings', 'coverSubject.png');
const robotSheet = asset('jpg_assortments', 'headSheet.png');
---

<Layout>
    <link slot="head" rel="preload" as="image" href={callanSubject.src} fetchpriority="high" />
    <div class="home-page">
        <main class="grid" aria-label="Portfolio pages">
            {tiles.map((tile, index) => {
                // The first three rows (the visible ones) load immediately; the rest wait until they are near the viewport
                const loading = index < 9 ? 'eager' : 'lazy';
                const isHome = tile.href === '/';
                const isMotion = tile.kind === 'motion';
                const Tag = isHome ? 'div' : isMotion ? 'button' : 'a';
                return (
                <Tag
                    {...(isHome ? { role: 'img' } : isMotion ? { type: 'button', 'data-motion-toggle': '' } : { href: tile.href })}
                    aria-label={tile.label}
                    class:list={['cover', `cover--${tile.kind}`, isHome && 'cover--static', tile.href === '/game' && 'cover--game', tile.label === 'Swaplings' && 'cover--swaplings', tile.kind === 'card' && 'cover--swaplings-card']}
                >
                    <span class="cover-tilt">
                    <span class="cover-shadow"></span>
                    <span class="cover-frame">
                    {tile.kind === 'photo' && (
                        <Image class="cover-image" src={photos[tile.file]} alt="" loading={loading} {...card} />
                    )}
                    {tile.kind === 'motion' && (
                        <span class="motion-cover">
                            <span class="motion-art">
                                <Image class="motion-machine" src={motionMachine} width={520} alt="" loading={loading} />
                                <Image class="motion-reel motion-reel--1" src={motionReel1} width={260} alt="" loading={loading} />
                                <Image class="motion-reel motion-reel--2" src={motionReel2} width={260} alt="" loading={loading} />
                            </span>
                        </span>
                    )}
                    {tile.kind === 'maps' && (
                        <span class="maps-cover">
                            <Image class="cover-image maps-back" src={asset('jpg_maps', 'cover_Back.webp')} alt="" aria-hidden="true" loading={loading} {...card} />
                            {[1, 2, 3, 4, 5, 6].map((layer) => (
                                <Image
                                    class="cover-image maps-cover-layer"
                                    src={asset('jpg_maps', `cover_${layer}.png`)}
                                    alt=""
                                    aria-hidden="true"
                                    loading={loading}
                                    data-map-layer={layer}
                                    style={`--map-layer: ${layer}; --map-rotation: ${(layer - 3.5) * 1.05}deg`}
                                    {...card}
                                />
                            ))}
                        </span>
                    )}
                    {tile.kind === 'bar' && (
                        <span class="bar-cover">
                            <Image class="cover-image" src={tile.href === '/game' ? asset('jpg_game', 'cover_night.webp') : asset('jpg_bar', 'coverDim.png')} alt="" loading={loading} {...card} />
                            <Image class="cover-image bar-cover-full" src={tile.href === '/game' ? asset('jpg_game', 'cover_day.webp') : asset('jpg_bar', 'coverFull.png')} alt="" aria-hidden="true" loading={loading} {...card} />
                        </span>
                    )}
                    {tile.kind === 'presents' && (
                        <span
                            class="presents-cover"
                            style={`--presents-disc: url(${presentsDisc.src}); --presents-subject: url(${presentsSubject.src})`}
                            data-warm={`${presentsDisc.src} ${presentsSubject.src}`}
                        >
                            <Image class="cover-image" src={asset('jpg_presents', 'cover_1.jpg')} alt="" loading={loading} {...card} />
                            <Image class="cover-image presents-cover-stage presents-cover-stage--3" src={asset('jpg_presents', 'cover_3.jpg')} alt="" aria-hidden="true" loading={loading} {...card} />
                            <Image class="cover-image presents-cover-stage presents-cover-stage--4" src={asset('jpg_presents', 'cover_4.jpg')} alt="" aria-hidden="true" loading={loading} {...card} />
                        </span>
                    )}
                    {tile.kind === 'fade' && (
                        <>
                            <Image class="cover-image" src={asset('jpg_animation', 'untitled.jpg')} alt="" loading={loading} {...card} />
                            <Image class="cover-image cover-fade" src={asset('jpg_animation', 'untitledBright.jpg')} alt="" aria-hidden="true" loading={loading} {...card} />
                        </>
                    )}
                    {tile.kind === 'mesh' && (
                        <span class="mesh-cover">
                            <Image class="cover-image mesh-blank" src={asset('jpg_callan', 'coverBlank.png')} alt="" loading={loading} {...card} />
                            <canvas class="cover-image mesh-canvas" aria-hidden="true" data-subject-src={callanSubject.src}></canvas>
                        </span>
                    )}
                    {tile.kind === 'card' && (
                        <span class="card-cover">
                            <span class="card-base">
                                <Image class="cover-image" src={asset('jpg_swaplings', 'coverBlank.png')} alt="" loading={loading} {...card} />
                            </span>
                            <Image
                                class="cover-popout"
                                src={swaplingsSubject}
                                alt=""
                                aria-hidden="true"
                                loading={loading}
                                data-subject-bounds={tile.subjectBounds}
                                data-aspect={swaplingsSubject.width / swaplingsSubject.height}
                                {...card}
                            />
                        </span>
                    )}
                    {tile.kind === 'robot' && (
                        <span class="robot-cover">
                            <span class="robot-artwork">
                                <Image class="robot-base" src={asset('jpg_assortments', 'coverHeadless.png')} alt="" loading={loading} {...card} />
                                <span class="robot-head" aria-hidden="true">
                                    <Image
                                        class="robot-sheet"
                                        src={robotSheet}
                                        alt=""
                                        widths={[300, 450, 600, 900]}
                                        sizes="(max-width: 560px) 34vw, (max-width: 960px) 17vw, 160px"
                                        format="webp"
                                        quality={85}
                                        loading={loading}
                                        decoding="async"
                                    />
                                </span>
                            </span>
                        </span>
                    )}
                    {tile.kind === 'layers' && (
                        <span class="exhibition-stack">
                            <Image class="cover-image exhibition-blank" src={asset('jpg_graphics', 'coverBlank.png')} alt="" loading={loading} {...card} />
                            {graphicsLayers.map(({ image, depth, layer, bounds, shadow }) => (
                                <span
                                    class:list={['exhibition-layer-pair', `exhibition-layer-pair--${layer}`]}
                                    data-depth={depth}
                                    data-bounds={bounds}
                                    style={`--shadow-color: ${shadow}`}
                                >
                                    <Image class="cover-image exhibition-shadow" src={asset('jpg_graphics', image)}                                     alt="" aria-hidden="true" loading={loading} {...card} />
                                                                        <Image class="cover-image exhibition-layer" src={asset('jpg_graphics', image)} alt="" loading={loading} {...card} />
                                </span>
                            ))}
                        </span>
                    )}
                    </span>
                    </span>
                </Tag>
                );
            })}
        </main>
    </div>
</Layout>

<style>
    :global(html),
    :global(body) {
        width: 100%;
        height: auto;
        min-height: 100%;
        overflow-x: hidden;
    }

    .home-page {
        display: flex;
        width: 100%;
        min-height: 100svh;
        flex-direction: column;
        overflow: visible;
        background: #fff;
        color: #121411;
        font-family: Arial, Helvetica, sans-serif;
    }

    .grid {
        position: relative;
        z-index: 1;
        display: grid;
        width: calc(100% - 3rem);
        max-width: 1440px;
        margin: 0 auto;
        padding: clamp(1.5rem, 4vh, 3.5rem) 0 4rem;
        box-sizing: border-box;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: clamp(1rem, 2vw, 1.75rem);
        overflow: visible;
    }

    .cover {
        position: relative;
        display: block;
        min-width: 0;
        aspect-ratio: 3 / 2;
        overflow: visible;
        border-radius: 0.75rem;
        -webkit-tap-highlight-color: transparent;
    }

    /* JS writes one inline transform here; the frame and shadow move together */
    .cover-tilt {
        position: absolute;
        inset: 0;
        display: block;
        border-radius: inherit;
        transform-origin: center;
        will-change: transform;
        backface-visibility: hidden;
    }

    .cover:focus-visible .cover-tilt {
        transform: perspective(1100px) translateY(-3px) scale(1.015);
    }

    /* The shadow is a static box-shadow; only its opacity animates */
    .cover-shadow {
        position: absolute;
        inset: 0;
        display: block;
        border-radius: inherit;
        box-shadow: 0 8px 18px rgb(18 20 17 / 14%);
        pointer-events: none;
    }

    .cover-shadow::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        box-shadow: 0 16px 28px rgb(18 20 17 / 20%);
        opacity: 0;
        transition: opacity 240ms cubic-bezier(0.2, 0.72, 0.2, 1);
    }

    .cover:hover .cover-shadow::after,
    .cover:focus-visible .cover-shadow::after,
    .cover.is-popping .cover-shadow::after {
        opacity: 1;
    }

    .cover--static {
        pointer-events: none;
        cursor: default;
    }

    button.cover {
        padding: 0;
        border: 0;
        background: none;
        color: inherit;
        font: inherit;
        text-align: inherit;
        cursor: pointer;
    }

    /* Motion machine: the filter lives on each image (not the animated parent), so the spinning reels stay compositor-only */
    .motion-cover {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: start;
        --mf: drop-shadow(0 8px 14px rgb(18 20 17 / 28%));
    }

    :global(html.no-motion) .motion-cover {
        --mf: grayscale(1) brightness(0.8) drop-shadow(0 8px 14px rgb(18 20 17 / 28%));
    }

    .cover--motion:hover .motion-cover,
    .cover--motion:focus-visible .motion-cover {
        --mf: drop-shadow(0 18px 22px rgb(18 20 17 / 45%));
    }

    :global(html.no-motion) .cover--motion:hover .motion-cover,
    :global(html.no-motion) .cover--motion:focus-visible .motion-cover {
        --mf: grayscale(1) brightness(0.8) drop-shadow(0 18px 22px rgb(18 20 17 / 45%));
    }
    .motion-art {
        position: relative;
        height: 76%;
        aspect-ratio: 1;
        margin-left: 3.7%;
    }

    .motion-art :global(img) {
        position: absolute;
        display: block;
        max-width: none;
        filter: var(--mf);
    }

    .motion-art :global(.motion-machine) {
        inset: 0;
        width: 100%;
        height: 100%;
    }

    .motion-art :global(.motion-reel) {
        left: -4.9%;
        width: 53.2%;
        height: 53.2%;
        animation: motion-spin 4.8s linear infinite;
        will-change: transform;
    }

    .motion-art :global(.motion-reel--1) {
        top: 2.2%;
    }

    .motion-art :global(.motion-reel--2) {
        top: 57%;
    }

    @keyframes motion-spin {
        to {
            transform: rotate(360deg);
        }
    }

    .cover--motion {
        height: 100%;
        aspect-ratio: 1;
        justify-self: start;
        border-radius: 0;
    }

    .cover--motion .cover-shadow {
        display: none;
    }

    .cover--motion .cover-frame.cover-frame {
        overflow: visible;
        background: none;
        border-radius: 0;
    }

    .cover--static .cover-shadow {
        display: none;
    }

    .cover-frame {
        position: absolute;
        inset: 0;
        display: block;
        overflow: hidden;
        border-radius: inherit;
        isolation: isolate;
        background: #e6e6e4;
    }

    .cover:hover,
    .cover:focus-visible,
    .cover.is-popping {
        z-index: 6;
    }

    .cover:focus-visible {
        outline: 3px solid #c5f36b;
        outline-offset: 4px;
    }

    .cover--swaplings:hover,
    .cover--swaplings.is-popping {
        z-index: 10;
    }

    .cover--swaplings .cover-frame {
        overflow: visible;
        background: transparent;
    }

    .cover-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .bar-cover,
    .maps-cover,
    .presents-cover,
    .robot-cover {
        position: absolute;
        inset: 0;
        display: block;
        overflow: hidden;
    }

    .maps-back {
        position: absolute;
        inset: 0;
    }

    .maps-cover-layer {
        position: absolute;
        inset: 0;
        z-index: calc(7 - var(--map-layer));
        transform: translateY(var(--map-lift, 0px)) rotate(var(--map-rotation));
        will-change: transform;
        pointer-events: none;
    }

    /* Cards stay hidden until every image in them is decoded, then appear at once */
    :global(html.js) .cover-frame:not(.is-ready) {
        opacity: 0;
    }

    .cover-frame {
        transition: opacity 0.35s ease;
    }

    .cover--maps:focus-visible .maps-cover-layer[data-map-layer='1'] {
        --map-lift: -14px;
    }

    /* Own compositor layers keep the repainting spotlight mask from resampling the card edges mid-tilt */
    .bar-cover .cover-image {
        transform: translateZ(0);
        backface-visibility: hidden;
        will-change: transform;
    }

    .bar-cover-full {
        will-change: transform, opacity, mask-image;
    }

    @property --bar-reveal {
        syntax: '<number>';
        inherits: false;
        initial-value: 0;
    }

    /* The spotlight grows from the pointer until it covers the whole card */
    .bar-cover-full {
        position: absolute;
        inset: 0;
        opacity: 0;
        --bar-reveal: 0;
        -webkit-mask-image: radial-gradient(
            ellipse calc(6% + 260% * var(--bar-reveal)) calc(8% + 260% * var(--bar-reveal)) at var(--bar-light-x, 50%) var(--bar-light-y, 50%),
            #000 0 38%,
            rgb(0 0 0 / 92%) 54%,
            transparent 100%
        );
        mask-image: radial-gradient(
            ellipse calc(6% + 260% * var(--bar-reveal)) calc(8% + 260% * var(--bar-reveal)) at var(--bar-light-x, 50%) var(--bar-light-y, 50%),
            #000 0 38%,
            rgb(0 0 0 / 92%) 54%,
            transparent 100%
        );
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
        -webkit-mask-size: 100% 100%;
        mask-size: 100% 100%;
        transition: --bar-reveal 200ms cubic-bezier(0.4, 0, 0.6, 1), opacity 0s linear 200ms;
        pointer-events: none;
    }

    .cover--bar:hover .bar-cover-full,
    .cover--bar:focus-visible .bar-cover-full {
        opacity: 1;
        --bar-reveal: 1;
        transition: --bar-reveal 240ms cubic-bezier(0.2, 0.7, 0.3, 1), opacity 140ms ease-out;
    }

    /* Game: a plain crossfade to the day image, with the same duration in and out */
    .cover--game .bar-cover-full {
        --bar-reveal: 0;
        -webkit-mask-image: none;
        mask-image: none;
        transition: --bar-reveal 0s linear 285ms, opacity 285ms ease-out;
    }

    .cover--game:hover .bar-cover-full,
    .cover--game:focus-visible .bar-cover-full {
        transition: --bar-reveal 0s, opacity 285ms ease-out;
    }
    /* Presents: a baked soft disc and the subject silhouette are intersected as masks */
    .presents-cover {
        container-type: size;
    }

    .presents-cover-stage {
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity 180ms ease;
        pointer-events: none;
        -webkit-mask-image: var(--presents-disc), var(--presents-subject);
        mask-image: var(--presents-disc), var(--presents-subject);
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
        -webkit-mask-size: var(--disc) var(--disc), 100% 100%;
        mask-size: var(--disc) var(--disc), 100% 100%;
        -webkit-mask-position:
            calc(var(--reveal-x, 50cqw) - var(--disc) / 2) calc(var(--reveal-y, 50cqh) - var(--disc) / 2),
            0 0;
        mask-position:
            calc(var(--reveal-x, 50cqw) - var(--disc) / 2) calc(var(--reveal-y, 50cqh) - var(--disc) / 2),
            0 0;
        -webkit-mask-composite: source-in;
        mask-composite: intersect;
    }

    .presents-cover-stage--3 {
        --disc: 67.9cqmin;
        z-index: 1;
    }

    .presents-cover-stage--4 {
        --disc: 40.53cqmin;
        z-index: 2;
    }

    .cover--presents:hover .presents-cover-stage,
    .cover--presents:focus-visible .presents-cover-stage {
        opacity: 1;
    }

    /* Robot: the head is one frame of a 3x3 sprite sheet, chosen by data-pose */
    .robot-artwork {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        display: block;
        width: 100%;
        height: auto;
        margin-block: auto;
        aspect-ratio: 2048 / 1536;
    }

    .robot-base {
        display: block;
        width: 100%;
        height: 100%;
    }

    .robot-head {
        position: absolute;
        left: 44.1%;
        top: 19.3%;
        width: 11.2%;
        aspect-ratio: 400 / 340;
        overflow: hidden;
        pointer-events: none;
    }

    .robot-sheet {
        position: absolute;
        top: 0;
        left: 0;
        width: 300%;
        height: 300%;
        max-width: none;
        will-change: transform;
    }

    .cover--robot[data-pose='1'] .robot-sheet { transform: translate(-33.3333%, 0); }
    .cover--robot[data-pose='2'] .robot-sheet { transform: translate(-66.6667%, 0); }
    .cover--robot[data-pose='3'] .robot-sheet { transform: translate(0, -33.3333%); }
    .cover--robot[data-pose='4'] .robot-sheet { transform: translate(-33.3333%, -33.3333%); }
    .cover--robot[data-pose='5'] .robot-sheet { transform: translate(-66.6667%, -33.3333%); }
    .cover--robot[data-pose='6'] .robot-sheet { transform: translate(0, -66.6667%); }
    .cover--robot[data-pose='7'] .robot-sheet { transform: translate(-33.3333%, -66.6667%); }
    .cover--robot[data-pose='8'] .robot-sheet { transform: translate(-66.6667%, -66.6667%); }

    .card-cover,
    .exhibition-stack,
    .mesh-cover {
        position: absolute;
        inset: 0;
        display: block;
        overflow: hidden;
    }

    .card-cover {
        overflow: visible;
        border-radius: inherit;
        perspective: 800px;
    }

    .card-base {
        position: absolute;
        inset: 0;
        display: block;
        overflow: hidden;
        border-radius: inherit;
    }

    .mesh-blank,
    .mesh-canvas {
        position: absolute;
        inset: 0;
        object-fit: cover;
    }

    .mesh-canvas {
        z-index: 1;
        pointer-events: none;
    }

    .cover--swaplings .cover-popout {
        filter: none;
    }

    /* One persistent layer: the logo is always the pop-out image, so nothing swaps on hover */
    .cover-popout {
        position: absolute;
        z-index: 3;
        top: 0;
        bottom: 0;
        left: 0;
        width: 100%;
        height: auto;
        margin-block: auto;
        object-fit: fill;
        transform-origin: 50% 50%;
        will-change: transform;
        backface-visibility: hidden;
        pointer-events: none;
    }

    .cover-fade {
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity 240ms ease;
        pointer-events: none;
    }

    .cover--fade:hover .cover-fade,
    .cover--fade:focus-visible .cover-fade {
        opacity: 1;
    }

    /* No motion: hover never swaps or reveals images on these covers */
    :global(html.no-motion) .cover--bar:hover .bar-cover-full,
    :global(html.no-motion) .cover--game:hover .bar-cover-full,
    :global(html.no-motion) .cover--bar:focus-visible .bar-cover-full,
    :global(html.no-motion) .cover--game:focus-visible .bar-cover-full,
    :global(html.no-motion) .cover--fade:hover .cover-fade,
    :global(html.no-motion) .cover--fade:focus-visible .cover-fade,
    :global(html.no-motion) .cover--presents:hover .presents-cover-stage,
    :global(html.no-motion) .cover--presents:focus-visible .presents-cover-stage {
        opacity: 0;
        --bar-reveal: 0;
    }

    .exhibition-stack {
