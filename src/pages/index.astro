---
import Layout from '../layouts/Layout.astro';

const graphicsLayers = [
    { image: 'cover_bottom_yellow.png', depth: 0.55, layer: 'bottom', bounds: '0.0755,0.138,0.2641,0.417', shadow: 'rgba(121, 101, 0, 0.22)' },
    { image: 'cover_bottom_red.png', depth: 0.6, layer: 'bottom', bounds: '0.4177,0.5852,0.251,0.312', shadow: 'rgba(125, 28, 33, 0.2)' },
    { image: 'cover_bottom_blue.png', depth: 0.65, layer: 'bottom', bounds: '0.4161,0.1361,0.2443,0.3593', shadow: 'rgba(0, 95, 116, 0.22)' },
    { image: 'cover_purple.png', depth: 0.8, layer: 'middle', bounds: '0.7625,0.138,0.1703,0.0491', shadow: 'rgba(83, 44, 119, 0.2)' },
    { image: 'cover_green.png', depth: 0.85, layer: 'middle', bounds: '0.7625,0.5852,0.175,0.312', shadow: 'rgba(20, 95, 36, 0.2)' },
    { image: 'cover_top_purple.png', depth: 1, layer: 'top', bounds: '0.0766,0.5167,0.5141,0.1213', shadow: 'rgba(83, 44, 119, 0.2)' },
    { image: 'cover_top_pink.png', depth: 1.1, layer: 'top', bounds: '0.6286,0.137,0.0927,0.3583', shadow: 'rgba(132, 31, 65, 0.2)' },
];

const tiles = [
    { href: '/game', label: 'Interactive Realtime Environment', kind: 'image', image: '/jpg_game/clouds_none.png' },
    {
        href: '/swaplings',
        label: 'Swaplings',
        kind: 'card',
        folder: 'swaplings',
        subjectBounds: '0.2492,0.0635,0.5053,0.8913',
    },
    { href: '/maps', label: 'Maps', kind: 'maps' },
    { href: '/animation', label: 'Short Animation', kind: 'fade', image: '/jpg_animation/untitled.jpg'     },
    {
        href: '/presents',
        label: 'Presents for Friends',
        kind: 'presents',
    },
    { href: '/callan', label: 'Graphic Wayfinding Concept', kind: 'mesh' },
    { href: '/graphics', label: 'Graphic Exhibition Concept', kind: 'layers' },
    { href: '/bar', label: 'Bar', kind: 'bar' },
    {
        href: '/assortments',
        label: 'Assortments',
        kind: 'robot',
    },
];
---

<Layout>
    <div class="home-page">
        <header class="site-header">
            <p class="name">Oliver Makeham</p>
        </header>
        <main class="grid" aria-label="Portfolio pages">
            {tiles.map((tile) => (
                <a
                    href={tile.href}
                    aria-label={tile.label}
                    class:list={['cover', `cover--${tile.kind}`, tile.href === '/game' && 'cover--game', tile.label === 'Swaplings' && 'cover--swaplings']}
                >
                    <span class="cover-frame">
                    {tile.kind === 'image' && (
                        <span class="game-cover">
                            <span class="game-artwork">
                                <img class="game-background" src={tile.image} alt="" />
                                <img class="game-swirl" src="/jpg_game/swirl.png" alt="" aria-hidden="true" />
                            </span>
                        </span>
                    )}
                    {tile.kind === 'maps' && (
                        <span class="maps-cover">
                            {[1, 2, 3, 4, 5, 6].map((layer) => (
                                <img
                                    class="cover-image maps-cover-layer"
                                    src={`/jpg_maps/cover_${layer}.png`}
                                    alt=""
                                    aria-hidden="true"
                                    data-map-layer={layer}
                                    style={`--map-layer: ${layer}; --map-rotation: ${(layer - 3.5) * 1.05}deg`}
                                />
                            ))}
                        </span>
                    )}
                    {tile.kind === 'bar' && (
                        <span class="bar-cover">
                            <img class="cover-image" src="/jpg_bar/coverDim.png" alt="" />
                            <img class="cover-image bar-cover-full" src="/jpg_bar/coverFull.png" alt="" aria-hidden="true" />
                        </span>
                    )}
                    {tile.kind === 'presents' && (
                        <span class="presents-cover">
                            <img class="cover-image" src="/jpg_presents/cover_1.jpg" alt="" />
                            <svg class="presents-mask-definitions" aria-hidden="true">
                                <defs>
                                    <filter id="presents-organic-edge" x="-20%" y="-20%" width="140%" height="140%">
                                        <feTurbulence
                                            type="fractalNoise"
                                            baseFrequency="0.018 0.03"
                                            numOctaves="2"
                                            seed="8"
                                            result="noise"
                                        />
                                        <feDisplacementMap
                                            in="SourceGraphic"
                                            in2="noise"
                                            scale="34"
                                            xChannelSelector="R"
                                            yChannelSelector="G"
                                        />
                                    </filter>
                                    <mask
                                        id="presents-subject-mask"
                                        maskUnits="userSpaceOnUse"
                                        mask-type="alpha"
                                    >
                                        <image
                                            href="/jpg_presents/coverSubject.png"
                                            width="100%"
                                            height="100%"
                                            preserveAspectRatio="none"
                                        />
                                    </mask>
                                    {[3, 4].map((stage) => (
                                        <>
                                            <radialGradient id={`presents-stage-${stage}-gradient`} gradientUnits="userSpaceOnUse">
                                                <stop offset="0%" stop-color="white" />
                                                <stop offset="64%" stop-color="white" />
                                                <stop offset="100%" stop-color="black" />
                                            </radialGradient>
                                            <mask
                                                id={`presents-stage-${stage}-mask`}
                                                maskUnits="userSpaceOnUse"
                                                mask-type="luminance"
                                            >
                                                <g mask="url(#presents-subject-mask)">
                                                    <rect
                                                        class="presents-mask-shape"
                                                        width="100%"
                                                        height="100%"
                                                        fill={`url(#presents-stage-${stage}-gradient)`}
                                                        filter="url(#presents-organic-edge)"
                                                    />
                                                </g>
                                            </mask>
                                        </>
                                    ))}
                                </defs>
                            </svg>
                            <img class="cover-image presents-cover-stage presents-cover-stage--3" src="/jpg_presents/cover_3.jpg" alt="" aria-hidden="true" />
                            <img class="cover-image presents-cover-stage presents-cover-stage--4" src="/jpg_presents/cover_4.jpg" alt="" aria-hidden="true" />
                        </span>
                    )}
                    {tile.kind === 'fade' && (
                        <>
                            <img class="cover-image" src={tile.image} alt="" />
                            <img class="cover-image cover-fade" src="/jpg_animation/untitledBright.jpg" alt="" aria-hidden="true" />
                        </>
                    )}
                    {tile.kind === 'mesh' && (
                        <span class="mesh-cover">
                            <img class="cover-image mesh-blank" src="/jpg_callan/coverBlank.png" alt="" />
                            <canvas class="cover-image mesh-canvas" aria-hidden="true"></canvas>
                        </span>
                    )}
                    {tile.kind === 'card' && (
                        <span class="card-cover">
                            <span class="card-base">
                                <img class="cover-image" src={`/jpg_${tile.folder}/coverBlank.png`} alt="" />
                                <img
                                    class="cover-image cover-subject"
                                    src={`/jpg_${tile.folder}/coverSubject.png`}
                                    alt=""
                                    data-subject-bounds={tile.subjectBounds}
                                />
                            </span>
                            <img
                                class="cover-image cover-popout"
                                src={`/jpg_${tile.folder}/coverSubject.png`}
                                alt=""
                                aria-hidden="true"
                                data-subject-bounds={tile.subjectBounds}
                            />
                        </span>
                    )}
                    {tile.kind === 'static-card' && (
                        <span class="static-card-cover">
                            <img class="cover-image" src={`/jpg_${tile.folder}/coverBlank.png`} alt="" />
                            <img class="cover-image static-card-subject" src={`/jpg_${tile.folder}/coverSubject.png`} alt="" />
                        </span>
                    )}
                    {tile.kind === 'robot' && (
                        <span class="robot-cover">
                            <span class="robot-artwork">
                                <img class="robot-base" src="/jpg_assortments/coverHeadless.png" alt="" />
                                <span class="robot-head">
                                    {[
                                        ['forward', 'ch_foward.png'],
                                        ['up', 'ch_up.png'],
                                        ['upright', 'ch_upright.png'],
                                        ['right', 'ch_right.png'],
                                        ['downright', 'ch_downright.png'],
                                        ['down', 'ch_down.png'],
                                        ['downleft', 'ch_downleft.png'],
                                        ['left', 'ch_left.png'],
                                        ['upleft', 'ch_upleft.png'],
                                    ].map(([direction, image]) => (
                                        <img
                                            class:list={['robot-head-direction', `robot-head-direction--${direction}`]}
                                            src={`/jpg_assortments/${image}`}
                                            alt=""
                                            aria-hidden="true"
                                            data-direction={direction}
                                        />
                                    ))}
                                </span>
                            </span>
                        </span>
                    )}
                    {tile.kind === 'layers' && (
                        <span class="exhibition-stack">
                            <img class="cover-image exhibition-blank" src="/jpg_graphics/coverBlank.png" alt="" />
                            {graphicsLayers.map(({ image, depth, layer, bounds, shadow }) => (
                                <span
                                    class:list={['exhibition-layer-pair', `exhibition-layer-pair--${layer}`]}
                                    data-depth={depth}
                                    data-bounds={bounds}
                                    data-shadow={shadow}
                                >
                                    <img
                                        class="cover-image exhibition-shadow"
                                        src={`/jpg_graphics/${image}`}
                                        alt=""
                                        aria-hidden="true"
                                    />
                                    <img
                                        class="cover-image exhibition-layer"
                                        src={`/jpg_graphics/${image}`}
                                        alt=""
                                    />
                                </span>
                            ))}
                        </span>
                    )}
                    </span>
                </a>
            ))}
        </main>
    </div>
</Layout>

<style>
    :global(html),
    :global(body) {
        width: 100%;
        height: auto;
        min-height: 100%;
        overflow-x: hidden;
    }

    .home-page {
        display: flex;
        width: 100%;
        min-height: 100svh;
        flex-direction: column;
        overflow: visible;
        background: #fff;
        color: #121411;
        font-family: Arial, Helvetica, sans-serif;
    }

    .site-header {
        position: relative;
        display: flex;
        min-height: 4rem;
        align-items: center;
        justify-content: space-between;
        padding: 0.5rem clamp(1rem, 3vw, 3rem);
        box-sizing: border-box;
    }

    .name {
        position: absolute;
        left: 50%;
        margin: 0;
        font-size: clamp(1rem, 2vw, 1.5rem);
        font-weight: 600;
        transform: translateX(-50%);
        white-space: nowrap;
    }

    .grid {
        position: relative;
        z-index: 1;
        display: grid;
        width: calc(100% - 3rem);
        max-width: 1440px;
        margin: 0 auto;
        padding: clamp(1.5rem, 4vh, 3.5rem) 0 4rem;
        box-sizing: border-box;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: clamp(1rem, 2vw, 1.75rem);
        overflow: visible;
    }

    .cover {
        position: relative;
        display: block;
        min-width: 0;
        aspect-ratio: 3 / 2;
        overflow: visible;
        border-radius: 0.75rem;
        -webkit-tap-highlight-color: transparent;
    }

    .cover-frame {
        position: absolute;
        inset: 0;
        display: block;
        overflow: hidden;
        border-radius: inherit;
        background: #e6e6e4;
        filter: drop-shadow(0 8px 18px rgb(18 20 17 / 14%));
        transform: perspective(1100px) translateY(var(--card-lift, 0px)) scale(var(--card-scale, 1)) rotateX(var(--card-rotate-x, 0deg)) rotateY(var(--card-rotate-y, 0deg));
        transform-origin: center;
        transition: filter 240ms cubic-bezier(0.2, 0.72, 0.2, 1);
    }

    .cover:hover,
    .cover:focus-visible,
    .cover.is-popping {
        z-index: 6;
    }

    .cover:hover .cover-frame,
    .cover:focus-visible .cover-frame,
    .cover.is-popping .cover-frame {
        filter: drop-shadow(0 16px 28px rgb(18 20 17 / 20%));
    }

    .cover:focus-visible {
        --card-lift: -3px;
        --card-scale: 1.015;
        --card-rotate-x: 0deg;
        --card-rotate-y: 0deg;
        outline: 3px solid #c5f36b;
        outline-offset: 4px;
    }

    .cover--swaplings:hover,
    .cover--swaplings.is-popping {
        z-index: 10;
    }

    .cover--swaplings:hover .cover-frame,
    .cover--swaplings:focus-visible .cover-frame,
    .cover--swaplings.is-popping .cover-frame {
        overflow: visible;
        background: transparent;
    }

    .cover-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .game-cover {
        position: absolute;
        inset: 0;
        display: block;
        overflow: hidden;
    }

    .game-artwork {
        position: absolute;
        top: 0;
        left: -9.26%;
        width: 118.52%;
        aspect-ratio: 16 / 9;
        perspective: 480px;
        perspective-origin: 50% 72%;
    }

    .game-background,
    .game-swirl {
        position: absolute;
        display: block;
        pointer-events: none;
    }

    .game-background {
        inset: 0;
        width: 100%;
        height: 100%;
    }

    .game-swirl {
        top: 10%;
        left: 49%;
        width: 20.5%;
        height: auto;
        opacity: 0;
        transform: perspective(480px) rotateX(58deg);
        transform-origin: 50% 50%;
        transition: opacity 900ms ease;
    }

    .cover--game:hover .game-swirl,
    .cover--game:focus-visible .game-swirl {
        opacity: 0.78;
        animation: game-swirl-rotate 96s linear infinite;
    }

    @keyframes game-swirl-rotate {
        to {
            transform: perspective(480px) rotateX(58deg) rotate(1turn);
        }
    }

    .bar-cover {
        position: absolute;
        inset: 0;
        display: block;
        overflow: hidden;
    }

    .maps-cover {
        position: absolute;
        inset: 0;
        display: block;
        overflow: hidden;
        background: url('/jpg_maps/cover_Back.jpg') center / cover no-repeat;
    }

    .maps-cover-layer {
        position: absolute;
        inset: 0;
        z-index: calc(7 - var(--map-layer));
        transform: translateY(var(--map-lift, 0px)) rotate(var(--map-rotation));
        transition: transform 520ms cubic-bezier(0.22, 0.7, 0.2, 1);
        pointer-events: none;
    }

    .cover--maps:focus-visible .maps-cover-layer[data-map-layer='1'] {
        --map-lift: -14px;
    }

    .bar-cover-full {
        position: absolute;
        inset: 0;
        opacity: 0;
        -webkit-mask-image: radial-gradient(
            ellipse 19% 25% at var(--bar-light-x, 50%) var(--bar-light-y, 50%),
            #000 0 38%,
            rgb(0 0 0 / 92%) 54%,
            transparent 100%
        );
        mask-image: radial-gradient(
            ellipse 19% 25% at var(--bar-light-x, 50%) var(--bar-light-y, 50%),
            #000 0 38%,
            rgb(0 0 0 / 92%) 54%,
            transparent 100%
        );
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
        -webkit-mask-size: 100% 100%;
        mask-size: 100% 100%;
        transition: opacity 180ms ease;
        pointer-events: none;
    }

    .presents-cover {
        position: absolute;
        inset: 0;
        display: block;
        overflow: hidden;
    }

    .presents-mask-definitions {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        pointer-events: none;
    }

    .presents-cover-stage {
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity 180ms ease;
        pointer-events: none;
    }

    .presents-cover-stage--3 {
        z-index: 1;
        -webkit-mask: url(#presents-stage-3-mask);
        mask: url(#presents-stage-3-mask);
    }

    .presents-cover-stage--4 {
        z-index: 2;
        -webkit-mask: url(#presents-stage-4-mask);
        mask: url(#presents-stage-4-mask);
    }

    .robot-cover {
        position: absolute;
        inset: 0;
        display: block;
        overflow: hidden;
    }

    .robot-artwork {
        position: absolute;
        display: block;
    }

    .robot-base {
        display: block;
        width: 100%;
        height: 100%;
    }

    .robot-head {
        position: absolute;
        left: 44.1%;
        top: 19.3%;
        width: 11.2%;
        aspect-ratio: 1109 / 944;
        pointer-events: none;
    }

    .robot-head-direction {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        opacity: 0;
        transform-origin: center;
        transition: opacity 110ms linear, transform 150ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    .robot-head-direction--forward {
        opacity: 1;
        transform: scale(0.9);
        transform-origin: center;
    }

    .cover--presents:hover .presents-cover-stage,
    .cover--presents:focus-visible .presents-cover-stage {
        opacity: 1;
    }

    .cover--bar:hover .bar-cover-full,
    .cover--bar:focus-visible .bar-cover-full {
        opacity: 1;
    }

    .card-cover,
    .static-card-cover,
    .exhibition-stack,
    .mesh-cover {
        position: absolute;
        inset: 0;
        display: block;
        overflow: hidden;
    }

    .card-cover {
        overflow: visible;
        border-radius: inherit;
        perspective: 800px;
    }

    .card-base {
        position: absolute;
        inset: 0;
        display: block;
        overflow: hidden;
        border-radius: inherit;
    }

    .static-card-subject {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .mesh-blank,
    .mesh-canvas {
        position: absolute;
        inset: 0;
        object-fit: cover;
    }

    .mesh-canvas {
        z-index: 1;
        pointer-events: none;
    }

    .cover-subject {
        position: absolute;
        inset: 0;
        z-index: 1;
        object-fit: cover;
        transition: none;
    }

    .cover--swaplings .cover-subject,
    .cover--swaplings .cover-popout {
        filter: drop-shadow(0 8px 18px rgb(18 20 17 / 14%));
    }

    .cover--card .card-cover.is-popping .cover-subject {
        opacity: 0;
    }

    .cover-popout {
        position: absolute;
        z-index: 3;
        object-fit: fill;
        transform-origin: 50% 50%;
        transform: translateY(0) rotateX(0deg) rotateY(0deg);
        opacity: 0;
        pointer-events: none;
        transition: transform 120ms cubic-bezier(0.2, 0.7, 0.3, 1), opacity 80ms ease;
    }

    .cover-popout.is-popped {
        opacity: 1;
    }

    .cover-fade {
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity 240ms ease;
        pointer-events: none;
    }

    .cover--fade:hover .cover-fade,
    .cover--fade:focus-visible .cover-fade {
        opacity: 1;
    }

    .exhibition-stack {
        perspective: 900px;
        transform-style: preserve-3d;
    }

    .exhibition-blank,
    .exhibition-layer-pair,
    .exhibition-shadow,
    .exhibition-layer {
        position: absolute;
        inset: 0;
    }

    .exhibition-blank {
        z-index: 0;
    }

    .exhibition-layer-pair {
        display: block;
        pointer-events: none;
    }

    .exhibition-shadow {
        z-index: 0;
        opacity: 0;
        filter: saturate(1.25) brightness(0.86) blur(1.1px);
        mix-blend-mode: multiply;
        transition: opacity 220ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .exhibition-layer {
        z-index: 1;
        pointer-events: none;
        transform-origin: center;
        transition: transform 220ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .exhibition-layer-pair--bottom {
        z-index: 1;
    }

    .exhibition-layer-pair--middle {
        z-index: 2;
    }

    .exhibition-layer-pair--top {
        z-index: 3;
    }

    @media (max-width: 960px) {
        .grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 560px) {
        .grid {
            width: calc(100% - 2rem);
            grid-template-columns: minmax(0, 1fr);
            gap: 1.25rem;
            padding-top: 1.25rem;
        }

        .cover {
            aspect-ratio: 3 / 2;
        }

        .site-header {
            min-height: 3.5rem;
            padding-inline: 0.75rem;
        }

        .name {
            font-size: 0.95rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .cover-popout,
        .cover,
        .exhibition-layer,
        .exhibition-shadow,
        .maps-cover-layer,
        .presents-cover-stage,
        .robot-head-direction {
            transition: none;
        }

        .cover--game:hover .game-swirl,
        .cover--game:focus-visible .game-swirl {
            animation: none;
            transform: perspective(480px) rotateX(58deg);
        }

        .bar-cover-full {
            transition: none;
        }

        .cover--card .card-cover.is-popping .cover-subject {
            opacity: 0;
        }

    }
</style>

<script>
const covers = Array.from(document.querySelectorAll<HTMLElement>('.cover'));
const cardMotion = covers.map((cover) => ({
    cover,
    lift: 0,
    scale: 1,
    rotateX: 0,
    rotateY: 0,
    targetLift: 0,
    targetScale: 1,
    targetRotateX: 0,
    targetRotateY: 0,
}));
let cardMotionFrame = 0;

const animateCardMotion = () => {
    cardMotionFrame = 0;
    let needsAnotherFrame = false;

    cardMotion.forEach((motion) => {
        motion.lift += (motion.targetLift - motion.lift) * 0.22;
        motion.scale += (motion.targetScale - motion.scale) * 0.22;
        motion.rotateX += (motion.targetRotateX - motion.rotateX) * 0.22;
        motion.rotateY += (motion.targetRotateY - motion.rotateY) * 0.22;

        if (
            Math.abs(motion.targetLift - motion.lift) > 0.01 ||
            Math.abs(motion.targetScale - motion.scale) > 0.0001 ||
            Math.abs(motion.targetRotateX - motion.rotateX) > 0.01 ||
            Math.abs(motion.targetRotateY - motion.rotateY) > 0.01
        ) {
            needsAnotherFrame = true;
        } else {
            motion.lift = motion.targetLift;
            motion.scale = motion.targetScale;
            motion.rotateX = motion.targetRotateX;
            motion.rotateY = motion.targetRotateY;
        }

        motion.cover.style.setProperty('--card-lift', `${motion.lift}px`);
        motion.cover.style.setProperty('--card-scale', `${motion.scale}`);
        motion.cover.style.setProperty('--card-rotate-x', `${motion.rotateX}deg`);
        motion.cover.style.setProperty('--card-rotate-y', `${motion.rotateY}deg`);
    });

    if (needsAnotherFrame) {
        cardMotionFrame = requestAnimationFrame(animateCardMotion);
    }
};

const scheduleCardMotion = () => {
    if (!cardMotionFrame) {
        cardMotionFrame = requestAnimationFrame(animateCardMotion);
    }
};

const updateCardProximity = (x: number, y: number) => {
    cardMotion.forEach((motion) => {
        const { cover } = motion;
        const bounds = cover.getBoundingClientRect();
        const { width, height, left, top, right, bottom } = bounds;
        const inside = x >= left && x <= right && y >= top && y <= bottom;
        const localX = (x - left) / width;
        const localY = (y - top) / height;
        let progress = 0;

        if (inside) {
            const edgeDepth = Math.min(localX, 1 - localX, localY, 1 - localY) * 2;
            const easedDepth = 1 - (1 - edgeDepth) ** 4;
            progress = 0.22 + 0.78 * easedDepth;
        } else {
            const dx = Math.max(left - x, 0, x - right);
            const dy = Math.max(top - y, 0, y - bottom);
            const radius = Math.min(width, height) * 0.13;
            const influence = Math.max(0, 1 - Math.hypot(dx, dy) / radius);
            progress = influence * influence * (3 - 2 * influence) * 0.22;
        }

        const tiltX = Math.max(-0.5, Math.min(0.5, 0.5 - localY));
        const tiltY = Math.max(-0.5, Math.min(0.5, localX - 0.5));
        motion.targetRotateX = tiltX * 16 * progress;
        motion.targetRotateY = tiltY * 16 * progress;
        motion.targetLift = -9 * progress;
        motion.targetScale = 1 + 0.03 * progress;
    });

    scheduleCardMotion();
};

window.addEventListener('pointermove', (event) => {
    if (event.pointerType === 'touch') return;
    updateCardProximity(event.clientX, event.clientY);
});
window.addEventListener('pointerout', (event) => {
    if (event.relatedTarget === null) {
        cardMotion.forEach((motion) => {
            motion.targetLift = 0;
            motion.targetScale = 1;
            motion.targetRotateX = 0;
            motion.targetRotateY = 0;
        });
        scheduleCardMotion();
    }
});
window.addEventListener('blur', () => {
    cardMotion.forEach((motion) => {
        motion.targetLift = 0;
        motion.targetScale = 1;
        motion.targetRotateX = 0;
        motion.targetRotateY = 0;
    });
    scheduleCardMotion();
});

document.querySelectorAll<HTMLElement>('.bar-cover').forEach((cover) => {
    const light = cover.querySelector<HTMLElement>('.bar-cover-full');
    if (!light) return;

    const placeLight = (x: number, y: number) => {
        const bounds = cover.getBoundingClientRect();
        const lightX = ((x - bounds.left) / bounds.width) * 100;
        const lightY = ((y - bounds.top) / bounds.height) * 100;
        light.style.setProperty('--bar-light-x', `${lightX}%`);
        light.style.setProperty('--bar-light-y', `${lightY}%`);
    };

    cover.addEventListener('pointermove', (event) => {
        if (event.pointerType === 'touch') return;
        placeLight(event.clientX, event.clientY);
    });

    cover.closest('a')?.addEventListener('focus', () => {
        const bounds = cover.getBoundingClientRect();
        placeLight(bounds.left + bounds.width / 2, bounds.top + bounds.height / 2);
    });

    cover.addEventListener('pointerleave', () => {
        light.style.removeProperty('--bar-light-x');
        light.style.removeProperty('--bar-light-y');
    });
});

document.querySelectorAll<HTMLElement>('.robot-cover').forEach((cover) => {
    const artwork = cover.querySelector<HTMLElement>('.robot-artwork');
    const base = cover.querySelector<HTMLImageElement>('.robot-base');
    const head = cover.querySelector<HTMLElement>('.robot-head');
    const directionImages = Array.from(
        cover.querySelectorAll<HTMLImageElement>('.robot-head-direction'),
    );
    const directions = ['up', 'upright', 'right', 'downright', 'down', 'downleft', 'left', 'upleft'];
    const forward = cover.querySelector<HTMLImageElement>('.robot-head-direction--forward');
    const sectorSize = (Math.PI * 2) / directions.length;
    const baseThreshold = sectorSize / 2;
    let currentDirection = -1;

    const showDirectionFrame = (angle: number, directionIndex: number) => {
        const activeDirection = directionIndex < 0 ? undefined : directions[directionIndex];
        let rotation = 0;

        if (directionIndex >= 0) {
            rotation = angle - directionIndex * sectorSize;
            rotation = ((rotation + Math.PI * 3) % (Math.PI * 2)) - Math.PI;
        }

        directionImages.forEach((image) => {
            const isActive = image === forward && directionIndex < 0
                || image.dataset.direction === activeDirection;
            image.style.opacity = isActive ? '1' : '0';
            if (isActive && directionIndex >= 0) {
                const scale = image === forward ? 'scale(0.9) ' : '';
                image.style.transform = `${scale}rotate(${rotation}rad)`;
            } else {
                image.style.removeProperty('transform');
            }
        });
    };

    const fitArtwork = () => {
        if (!artwork || !base?.naturalWidth || !base.naturalHeight) return;
        const width = cover.clientWidth;
        const height = cover.clientHeight;
        const scale = Math.max(
            width / base.naturalWidth,
            height / base.naturalHeight,
        );
        const artworkWidth = base.naturalWidth * scale;
        const artworkHeight = base.naturalHeight * scale;
        const widthStyle = `${artworkWidth}px`;
        const heightStyle = `${artworkHeight}px`;
        const leftStyle = `${(width - artworkWidth) / 2}px`;
        const topStyle = `${(height - artworkHeight) / 2}px`;
        if (artwork.style.width !== widthStyle) artwork.style.width = widthStyle;
        if (artwork.style.height !== heightStyle) artwork.style.height = heightStyle;
        if (artwork.style.left !== leftStyle) artwork.style.left = leftStyle;
        if (artwork.style.top !== topStyle) artwork.style.top = topStyle;
    };

    if (base?.complete) {
        fitArtwork();
    } else {
        base?.addEventListener('load', fitArtwork, { once: true });
    }
    const artworkObserver = new ResizeObserver(fitArtwork);
    artworkObserver.observe(cover);
    window.addEventListener('resize', fitArtwork);

    const showDirection = (x: number, y: number) => {
        if (!forward || !head) return;
        fitArtwork();
        const bounds = cover.getBoundingClientRect();
        const headBounds = head.getBoundingClientRect();
        const pivotX = headBounds.left + headBounds.width / 2;
        const pivotY = headBounds.top + headBounds.height / 2;
        const offsetX = x - pivotX;
        const offsetY = y - pivotY;
        const distance = Math.hypot(offsetX, offsetY);
        const deadZone = Math.min(bounds.width, bounds.height) * 0.045;
        if (distance < deadZone) {
            currentDirection = -1;
            showDirectionFrame(0, -1);
            return;
        }

        const angle = (Math.atan2(offsetX, -offsetY) + Math.PI * 2) % (Math.PI * 2);
        const distanceProgress = Math.min(
            1,
            distance / (Math.min(bounds.width, bounds.height) * 0.75),
        );
        const threshold = baseThreshold + distanceProgress * (Math.PI / 18);
        const nearestDirection = Math.round(angle / sectorSize) % directions.length;

        if (currentDirection === -1) {
            currentDirection = nearestDirection;
        } else {
            const currentAngle = currentDirection * sectorSize;
            const angleDifference = Math.abs(
                ((angle - currentAngle + Math.PI * 3) % (Math.PI * 2)) - Math.PI,
            );
            if (angleDifference > threshold) currentDirection = nearestDirection;
        }

        showDirectionFrame(angle, currentDirection);
    };

    const resetDirection = () => {
        currentDirection = -1;
        showDirectionFrame(0, -1);
    };

    cover.addEventListener('pointermove', (event) => {
        if (event.pointerType === 'touch') return;
        showDirection(event.clientX, event.clientY);
    });
    cover.addEventListener('pointerleave', resetDirection);
    cover.closest('a')?.addEventListener('focus', resetDirection);
});

document.querySelectorAll<HTMLElement>('.presents-cover').forEach((cover) => {
    let pointerX = cover.clientWidth / 2;
    let pointerY = cover.clientHeight / 2;

    const setRevealPoint = (x: number, y: number) => {
        const svg = cover.querySelector<SVGSVGElement>('.presents-mask-definitions');
        if (!svg) return;
        svg.setAttribute('viewBox', `0 0 ${cover.clientWidth} ${cover.clientHeight}`);

        const outerRadius = Math.min(cover.clientWidth, cover.clientHeight) * 0.38;
        const stageRadii = new Map([[3, outerRadius * 0.67], [4, outerRadius * 0.4]]);
        stageRadii.forEach((radius, stage) => {
            const gradient = svg.querySelector<SVGRadialGradientElement>(`#presents-stage-${stage}-gradient`);
            gradient?.setAttribute('cx', `${x}`);
            gradient?.setAttribute('cy', `${y}`);
            gradient?.setAttribute('r', `${radius}`);
        });
    };

    cover.addEventListener('pointermove', (event) => {
        if (event.pointerType === 'touch') return;
        const bounds = cover.getBoundingClientRect();
        pointerX = ((event.clientX - bounds.left) / bounds.width) * cover.clientWidth;
        pointerY = ((event.clientY - bounds.top) / bounds.height) * cover.clientHeight;
        setRevealPoint(pointerX, pointerY);
    });

    cover.closest('a')?.addEventListener('focus', () => {
        pointerX = cover.clientWidth / 2;
        pointerY = cover.clientHeight / 2;
        setRevealPoint(pointerX, pointerY);
    });
    new ResizeObserver(() => setRevealPoint(pointerX, pointerY)).observe(cover);
});

document.querySelectorAll<HTMLElement>('.maps-cover').forEach((cover) => {
    const layers = Array.from(cover.querySelectorAll<HTMLImageElement>('.maps-cover-layer'))
        .sort((a, b) => Number(a.dataset.mapLayer) - Number(b.dataset.mapLayer));
    const alphaMasks = new Map<HTMLImageElement, Uint8ClampedArray>();
    const maskSize = 256;
    const edgeRadius = 18;

    const prepareAlphaMask = (image: HTMLImageElement) => {
        if (!image.naturalWidth || !image.naturalHeight || alphaMasks.has(image)) return;

        const canvas = document.createElement('canvas');
        canvas.width = maskSize;
        canvas.height = maskSize;
        const context = canvas.getContext('2d', { willReadFrequently: true });
        if (!context) throw new Error('Unable to create map cover hit-test canvas');

        context.drawImage(image, 0, 0, maskSize, maskSize);
        alphaMasks.set(image, context.getImageData(0, 0, maskSize, maskSize).data);
    };

    layers.forEach((image) => {
        image.addEventListener('load', () => prepareAlphaMask(image), { once: true });
        if (image.complete) prepareAlphaMask(image);
    });

    const setLift = (image: HTMLImageElement | undefined, distance: number) => {
        if (image) image.style.setProperty('--map-lift', `${distance}px`);
    };

    const distanceToAlpha = (
        mask: Uint8ClampedArray,
        position: { x: number; y: number },
        isOpaque: boolean,
    ) => {
        let nearestDistance = edgeRadius + 1;

        for (let y = -edgeRadius; y <= edgeRadius; y += 1) {
            for (let x = -edgeRadius; x <= edgeRadius; x += 1) {
                const distance = Math.hypot(x, y);
                if (distance >= nearestDistance || distance > edgeRadius) continue;
                const sampleX = position.x + x;
                const sampleY = position.y + y;
                if (sampleX < 0 || sampleX >= maskSize || sampleY < 0 || sampleY >= maskSize) continue;
                const alpha = mask[(sampleY * maskSize + sampleX) * 4 + 3];
                if ((alpha > 16) === isOpaque) nearestDistance = distance;
            }
        }

        return nearestDistance;
    };

    const resetLifts = () => {
        layers.forEach((image) => {
            image.style.removeProperty('--map-lift');
        });
    };

    cover.addEventListener('pointermove', (event) => {
        if (event.pointerType === 'touch') return;

        const bounds = cover.getBoundingClientRect();
        const getMaskPosition = (image: HTMLImageElement) => {
            const layerNumber = Number(image.dataset.mapLayer);
            const rotation = ((layerNumber - 3.5) * 1.05 * Math.PI) / 180;
            const offsetX = event.clientX - (bounds.left + bounds.width / 2);
            const offsetY = event.clientY - (bounds.top + bounds.height / 2);
            const x = Math.cos(rotation) * offsetX + Math.sin(rotation) * offsetY + bounds.width / 2;
            const y = -Math.sin(rotation) * offsetX + Math.cos(rotation) * offsetY + bounds.height / 2;
            const scale = Math.max(bounds.width / image.naturalWidth, bounds.height / image.naturalHeight);
            const renderedWidth = image.naturalWidth * scale;
            const renderedHeight = image.naturalHeight * scale;
            const sourceX = (x - (bounds.width - renderedWidth) / 2) / renderedWidth;
            const sourceY = (y - (bounds.height - renderedHeight) / 2) / renderedHeight;

            if (sourceX < 0 || sourceX > 1 || sourceY < 0 || sourceY > 1) return undefined;
            return {
                x: Math.min(maskSize - 1, Math.floor(sourceX * maskSize)),
                y: Math.min(maskSize - 1, Math.floor(sourceY * maskSize)),
            };
        };

        const positions = layers.map((layer) => {
            const mask = alphaMasks.get(layer);
            if (!mask || !layer.naturalWidth) return undefined;
            const position = getMaskPosition(layer);
            if (!position) return undefined;
            const alpha = mask[(position.y * maskSize + position.x) * 4 + 3];
            return { mask, position, alpha };
        });
        const raisedIndex = positions.findIndex((position) => position && position.alpha > 16);

        resetLifts();
        if (raisedIndex === -1) return;
        const raisedPosition = positions[raisedIndex];
        if (!raisedPosition) return;
        const distanceToEdge = distanceToAlpha(raisedPosition.mask, raisedPosition.position, false);
        const liftProgress = 1 - (1 - Math.min(1, distanceToEdge / edgeRadius)) ** 7;
        setLift(layers[raisedIndex], -14 * liftProgress);

        if (raisedIndex === 0) return;
        const previousIndex = raisedIndex - 1;
        const previousPosition = positions[previousIndex];
        if (!previousPosition || previousPosition.alpha > 16) return;

        const nearestOpaque = distanceToAlpha(previousPosition.mask, previousPosition.position, true);
        const edgeProgress = Math.max(0, 1 - nearestOpaque / edgeRadius);
        const edgeLift = edgeProgress * edgeProgress * (3 - 2 * edgeProgress);
        if (edgeLift > 0) setLift(layers[previousIndex], -14 * edgeLift * 0.35);
    });

    cover.addEventListener('pointerleave', resetLifts);
});

document.querySelectorAll<HTMLElement>('.card-cover').forEach((card) => {
    const subject = card.querySelector<HTMLImageElement>('.cover-popout');
    const cover = card.closest<HTMLElement>('.cover--card');
    if (!subject) return;
    let isActive = false;

    const fitSubjectToCover = () => {
        if (!subject.naturalWidth || !subject.naturalHeight) return;

        const cardWidth = card.clientWidth;
        const cardHeight = card.clientHeight;
        const imageScale = Math.max(
            cardWidth / subject.naturalWidth,
            cardHeight / subject.naturalHeight,
        );
        const width = subject.naturalWidth * imageScale;
        const height = subject.naturalHeight * imageScale;
        const left = (cardWidth - width) / 2;
        const top = (cardHeight - height) / 2;

        subject.style.width = `${width}px`;
        subject.style.height = `${height}px`;
        subject.style.left = `${left}px`;
        subject.style.top = `${top}px`;
    };

    const moveSubject = (event: PointerEvent) => {
        if (event.pointerType === 'touch') return;
        const cardBounds = cover?.getBoundingClientRect() ?? card.getBoundingClientRect();
        const overCard =
            event.clientX >= cardBounds.left &&
            event.clientX <= cardBounds.right &&
            event.clientY >= cardBounds.top &&
            event.clientY <= cardBounds.bottom;
        const popoutMarginX = cardBounds.width * 0.2;
        const popoutMarginY = cardBounds.height * 0.22;
        const overPopout =
            isActive &&
            event.clientX >= cardBounds.left - popoutMarginX &&
            event.clientX <= cardBounds.right + popoutMarginX &&
            event.clientY >= cardBounds.top - popoutMarginY &&
            event.clientY <= cardBounds.bottom + popoutMarginY;

        if (!overCard && !overPopout) {
            if (isActive) resetSubject();
            return;
        }

        const boundsData = subject.dataset.subjectBounds?.split(',').map(Number);
        if (
            !boundsData ||
            boundsData.length !== 4 ||
            boundsData.some(Number.isNaN) ||
            !subject.naturalWidth ||
            !subject.naturalHeight
        ) {
            return;
        }

        const box = card.getBoundingClientRect();
        const imageScale = Math.max(
            box.width / subject.naturalWidth,
            box.height / subject.naturalHeight,
        );
        const imageWidth = subject.naturalWidth * imageScale;
        const imageHeight = subject.naturalHeight * imageScale;
        const imageLeft = box.left + (box.width - imageWidth) / 2;
        const imageTop = box.top + (box.height - imageHeight) / 2;
        const [sourceX, sourceY, sourceWidth, sourceHeight] = boundsData;
        const subjectLeft = imageLeft + sourceX * imageWidth;
        const subjectTop = imageTop + sourceY * imageHeight;
        const subjectWidth = sourceWidth * imageWidth;
        const subjectHeight = sourceHeight * imageHeight;
        const x = (event.clientX - subjectLeft) / subjectWidth;
        const y = (event.clientY - subjectTop) / subjectHeight;
        if (x < 0 || x > 1 || y < 0 || y > 1) {
            if (isActive) resetSubject();
            return;
        }

        const rotateX = (0.5 - y) * 6;
        const rotateY = (x - 0.5) * 6;
        const distanceToEdge = Math.min(x, 1 - x, y, 1 - y) * 2;
        const isSwaplings = cover?.classList.contains('cover--swaplings') ?? false;
        const logoDistance = Math.hypot((x - 0.5) / 0.76, (y - 0.84) / 0.48);
        const logoInfluence = isSwaplings
            ? (1 - Math.min(1, logoDistance)) ** 2
            : 0;
        const liftProgress = 1 - (1 - Math.min(1, distanceToEdge + logoInfluence)) ** 7;
        const maxScale = isSwaplings ? 1.1 : 1.02;
        const scale = 1 + (maxScale - 1) * liftProgress + logoInfluence * 0.015;
        const logoRise = logoInfluence * 4;

        isActive = true;
        subject.style.transformOrigin = '50% 50%';
        subject.style.transform =
            `translateY(${-logoRise}px) scale(${scale}) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
        card.classList.add('is-popping');
        cover?.classList.add('is-popping');
        subject.classList.add('is-popped');
    };

    const resetSubject = () => {
        isActive = false;
        subject.style.removeProperty('transform');
        subject.style.removeProperty('transform-origin');
        card.classList.remove('is-popping');
        cover?.classList.remove('is-popping');
        subject.classList.remove('is-popped');
    };

    card.addEventListener('pointerenter', moveSubject);
    window.addEventListener('pointermove', moveSubject);
    window.addEventListener('pointercancel', resetSubject);
    subject.addEventListener('load', fitSubjectToCover);
    new ResizeObserver(fitSubjectToCover).observe(card);
    fitSubjectToCover();
});

document.querySelectorAll<HTMLElement>('.exhibition-stack').forEach((stack) => {
    const pairs = stack.querySelectorAll<HTMLElement>('.exhibition-layer-pair');
    let pointer: { x: number; y: number } | null = null;
    let animationFrame = 0;

    pairs.forEach((pair) => {
        const shadow = pair.querySelector<HTMLElement>('.exhibition-shadow');
        if (shadow) {
            shadow.style.filter =
                `saturate(1.25) brightness(0.86) blur(1.4px) ` +
                `drop-shadow(-1px 1.5px 2.5px ${pair.dataset.shadow})`;
        }
    });

    const renderLayers = () => {
        animationFrame = 0;
        if (!pointer) return;
        const bounds = stack.getBoundingClientRect();
        const radius = Math.min(bounds.width, bounds.height) * 0.16;

        pairs.forEach((pair) => {
            const layer = pair.querySelector<HTMLElement>('.exhibition-layer');
            const shadow = pair.querySelector<HTMLElement>('.exhibition-shadow');
            const depth = Number(pair.dataset.depth);
            const boundsData = pair.dataset.bounds?.split(',').map(Number);
            if (!layer || !shadow) return;

            if (!boundsData || boundsData.length !== 4 || boundsData.some(Number.isNaN)) {
                layer.style.removeProperty('transform');
                shadow.style.removeProperty('transform');
                shadow.style.removeProperty('opacity');
                shadow.style.removeProperty('filter');
                return;
            }

            const [sourceX, sourceY, sourceWidth, sourceHeight] = boundsData;
            const imageScale = Math.max(bounds.width / 1920, bounds.height / 1080);
            const imageWidth = 1920 * imageScale;
            const imageHeight = 1080 * imageScale;
            const imageLeft = bounds.left + (bounds.width - imageWidth) / 2;
            const imageTop = bounds.top + (bounds.height - imageHeight) / 2;
            const artLeft = imageLeft + sourceX * imageWidth;
            const artTop = imageTop + sourceY * imageHeight;
            const artRight = artLeft + sourceWidth * imageWidth;
            const artBottom = artTop + sourceHeight * imageHeight;
            const nearestX = Math.max(artLeft, Math.min(pointer.x, artRight));
            const nearestY = Math.max(artTop, Math.min(pointer.y, artBottom));
            const offsetX = pointer.x - nearestX;
            const offsetY = pointer.y - nearestY;
            const distance = Math.hypot(offsetX, offsetY);

            if (distance >= radius) {
                layer.style.removeProperty('transform');
                shadow.style.removeProperty('transform');
                shadow.style.removeProperty('opacity');
                return;
            }

            const influence = 1 - distance / radius;
            const localX = Math.max(-1, Math.min(1, offsetX / radius));
            const localY = Math.max(-1, Math.min(1, offsetY / radius));
            const lift = influence * depth * 10;
            const popDepth = influence * depth * 14;
            const rotateX = -localY * influence * depth * 2;
            const rotateY = localX * influence * depth * 2;

            layer.style.transform =
                `translate3d(0, ${-lift}px, ${popDepth}px) ` +
                `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
            const shadowOffset = lift * 0.32;
            shadow.style.transform =
                `translate3d(${-shadowOffset}px, ${shadowOffset * 0.28}px, 0)`;
            shadow.style.opacity = `${Math.min(0.22, influence * depth * 0.18)}`;
        });
    };

    const moveLayers = (event: PointerEvent) => {
        if (event.pointerType === 'touch') return;
        pointer = { x: event.clientX, y: event.clientY };
        if (!animationFrame) {
            animationFrame = requestAnimationFrame(renderLayers);
        }
    };

    const resetLayers = () => {
        pointer = null;
        if (animationFrame) {
            cancelAnimationFrame(animationFrame);
            animationFrame = 0;
        }
        pairs.forEach((pair) => {
            const layer = pair.querySelector<HTMLElement>('.exhibition-layer');
            const shadow = pair.querySelector<HTMLElement>('.exhibition-shadow');
            layer?.style.removeProperty('transform');
            shadow?.style.removeProperty('transform');
            shadow?.style.removeProperty('opacity');
        });
    };

    stack.addEventListener('pointerenter', moveLayers);
    stack.addEventListener('pointermove', moveLayers);
    stack.addEventListener('pointerleave', resetLayers);
});

    document.querySelectorAll<HTMLElement>('.mesh-cover').forEach((cover) => {
        const canvas = cover.querySelector<HTMLCanvasElement>('.mesh-canvas');
        if (!canvas) return;

        const context = canvas.getContext('2d');
        if (!context) return;

        const sourceCanvas = document.createElement('canvas');
        const sourceContext = sourceCanvas.getContext('2d', { willReadFrequently: true });
        if (!sourceContext) return;

        const subject = new Image();
        subject.src = '/jpg_callan/coverSubject.png';

        let pointer: { x: number; y: number } | null = null;
        let animationFrame = 0;
        let pixelRatio = 1;
        let sourcePixels: ImageData | null = null;
        let contactFalloffs: Float32Array | null = null;

        const smoothstep = (value: number) => {
            const clamped = Math.max(0, Math.min(1, value));
            return clamped * clamped * clamped *
                (clamped * (clamped * 6 - 15) + 10);
        };
        const contactMask = (
            x: number,
            y: number,
            centerX: number,
            centerY: number,
            radiusX: number,
            radiusY: number,
            blend: number,
        ) => {
            const distance = Math.sqrt(
                ((x - centerX) / radiusX) ** 2 +
                ((y - centerY) / radiusY) ** 2,
            );
            return smoothstep((distance - 1) / blend);
        };

        const render = () => {
            animationFrame = 0;
            if (!subject.complete || !subject.naturalWidth) return;

            const width = cover.clientWidth;
            const height = cover.clientHeight;
            pixelRatio = Math.min(window.devicePixelRatio || 1, 1.25);

            const canvasWidth = Math.round(width * pixelRatio);
            const canvasHeight = Math.round(height * pixelRatio);
            if (canvas.width !== canvasWidth || canvas.height !== canvasHeight) {
                canvas.width = canvasWidth;
                canvas.height = canvasHeight;
                sourceCanvas.width = canvasWidth;
                sourceCanvas.height = canvasHeight;
                sourcePixels = null;
                contactFalloffs = null;
            }

            const scale = Math.max(width / subject.naturalWidth, height / subject.naturalHeight);
            const cropWidth = width / scale;
            const cropHeight = height / scale;
            const cropLeft = (subject.naturalWidth - cropWidth) / 2;
            const cropTop = (subject.naturalHeight - cropHeight) / 2;

            if (!sourcePixels) {
                sourceContext.clearRect(0, 0, canvasWidth, canvasHeight);
                sourceContext.drawImage(
                    subject,
                    cropLeft,
                    cropTop,
                    cropWidth,
                    cropHeight,
                    0,
                    0,
                    canvasWidth,
                    canvasHeight,
                );
                sourcePixels = sourceContext.getImageData(0, 0, canvasWidth, canvasHeight);
            }

            if (!contactFalloffs) {
                contactFalloffs = new Float32Array(canvasWidth * canvasHeight);
                for (let y = 0; y < canvasHeight; y += 1) {
                    const sourceNormalizedY =
                        (cropTop + (y / canvasHeight) * cropHeight) / subject.naturalHeight;
                    for (let x = 0; x < canvasWidth; x += 1) {
                        const sourceNormalizedX =
                            (cropLeft + (x / canvasWidth) * cropWidth) / subject.naturalWidth;
                        contactFalloffs[y * canvasWidth + x] = Math.min(
                            contactMask(sourceNormalizedX, sourceNormalizedY, 0.58, 0.08, 0.3, 0.1, 0.45),
                            contactMask(sourceNormalizedX, sourceNormalizedY, 0.55, 0.83, 0.4, 0.05, 0.7),
                        );
                    }
                }
            }

            if (!pointer) {
                context.clearRect(0, 0, canvasWidth, canvasHeight);
                context.drawImage(sourceCanvas, 0, 0);
                return;
            }

            const output = context.createImageData(canvasWidth, canvasHeight);
            const input = sourcePixels.data;
            const pixels = output.data;
            const pointerX = pointer.x * pixelRatio;
            const pointerY = pointer.y * pixelRatio;
            const radiusX = canvasWidth * 0.2;
            const radiusY = canvasHeight * 0.2;

            for (let y = 0; y < canvasHeight; y += 1) {
                const dy = y - pointerY;
                for (let x = 0; x < canvasWidth; x += 1) {
                    const dx = x - pointerX;
                    const distanceSquared = (dx / radiusX) ** 2 + (dy / radiusY) ** 2;
                    const influence =
                        Math.exp(-distanceSquared * 2.4) * contactFalloffs[y * canvasWidth + x];
                    const sourceX = Math.max(
                        0,
                        Math.min(canvasWidth - 1.001, x - dx * influence * 0.08),
                    );
                    const sourceY = Math.max(
                        0,
                        Math.min(canvasHeight - 1.001, y - dy * influence * 0.08),
                    );
                    const left = Math.floor(sourceX);
                    const top = Math.floor(sourceY);
                    const xWeight = sourceX - left;
                    const yWeight = sourceY - top;
                    const sourceIndex = (top * canvasWidth + left) * 4;
                    const outputIndex = (y * canvasWidth + x) * 4;

                    for (let channel = 0; channel < 4; channel += 1) {
                        const topLeft = input[sourceIndex + channel];
                        const topRight = input[sourceIndex + 4 + channel];
                        const bottomLeft = input[sourceIndex + canvasWidth * 4 + channel];
                        const bottomRight = input[sourceIndex + (canvasWidth + 1) * 4 + channel];
                        const topValue = topLeft + (topRight - topLeft) * xWeight;
                        const bottomValue = bottomLeft + (bottomRight - bottomLeft) * xWeight;
                        pixels[outputIndex + channel] =
                            topValue + (bottomValue - topValue) * yWeight;
                    }
                }
            }

            context.putImageData(output, 0, 0);
        };

        const scheduleRender = () => {
            if (!animationFrame) {
                animationFrame = requestAnimationFrame(render);
            }
        };

        cover.addEventListener('pointermove', (event) => {
            if (event.pointerType === 'touch') return;
            const bounds = cover.getBoundingClientRect();
            pointer = {
                x: ((event.clientX - bounds.left) / bounds.width) * cover.clientWidth,
                y: ((event.clientY - bounds.top) / bounds.height) * cover.clientHeight,
            };
            scheduleRender();
        });

        cover.addEventListener('pointerleave', () => {
            pointer = null;
            scheduleRender();
        });

        subject.addEventListener('load', scheduleRender);
        new ResizeObserver(scheduleRender).observe(cover);
    });

    </script>
