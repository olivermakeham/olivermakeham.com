---
import Layout from '../layouts/Layout.astro';

const groups = [
    {
        name: 'BLUE',
        rows: [['BLUE_w1.jpg', 'BLUE_s1.jpg', 'BLUE_s2.jpg']],
    },
    {
        name: 'FACT',
        rows: [['FACT_w1.jpg', 'FACT_w2.jpg'], ['FACT_s1.jpg', 'FACT_s2.jpg', 'FACT_s3.jpg']],
    },
    {
        name: 'HOUSE',
        rows: [['HOUSE_w1.jpg', 'HOUSE_s1.jpg'], ['HOUSE_s2.jpg', 'HOUSE_s3.jpg', 'HOUSE_s4.jpg']],
    },
    {
        name: 'LAND',
        rows: [['LAND_s1.jpg', 'LAND_w1.jpg', 'LAND_w2.jpg']],
    },
    {
        name: 'YARD',
        rows: [
            ['YARD_s1.jpg', 'YARD_s2.jpg', 'YARD_s3.jpg'],
            ['YARD_s4.jpg', 'YARD_w2.jpg', 'YARD_w3.jpg'],
        ],
    },
];
---

<Layout title="Interactive Realtime Environment — Oliver Makeham">
    <main class="game-page">
        <header class="intro">
            <h1>Interactive Realtime Environment</h1>
        </header>

        <div class="project-copy">
            <p>I made this explorable 3D space in Unity to explore a story through environmental design, without the need for instructional text or exposition. The player navigates the empty factory to examine damage within a facility, piecing together the mysterious disappearance of its sole worker. It establishes a stark juxtaposition visually, with the dull, lonely colours of the exterior contrasted by the vibrant, warm interior, balancing corporate blue coldness with natural warmth. The model and textures are stylised with low poly geometry and painterly textures, which also allowed for a greater range of assets to be created in a shorter period of time. Integrated scripts manage animations, sound effects and custom music, and particle systems that emphasise the emptiness and solitude of the facility. Exploration is also mechanically driven as it requires players to search the environment for a keycard that unlock the main blast door at the end.</p>
            <p>I was responsible for the entire production of the game, from the original modelling, texturing, layout, music and more.</p>
        </div>

        <figure class="overview">
            <img
                src="/jpg_game/YARD_w1.jpg"
                alt="Wide view of the yard"
                loading="eager"
                decoding="async"
            />
        </figure>

        <div class="groups">
            {groups.map((group) => (
                <section class="gallery" aria-label={`${group.name} game artwork`}>
                    {group.rows.map((row) => (
                        <div class="gallery-row">
                            {row.map((image) => (
                                <figure class:list={['tile', image.includes('_w') && 'tile--wide']}>
                                    <img
                                        src={`/jpg_game/${image}`}
                                        alt="Game environment artwork"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                </figure>
                            ))}
                        </div>
                    ))}
                </section>
            ))}
        </div>

        <figure class="overview overview--final">
            <img
                src="/jpg_game/OVERVIEW.jpg"
                alt="Aerial overview of the game site"
                loading="lazy"
                decoding="async"
            />
        </figure>

        <a
            class="door-link"
            href="https://play.unity.com/en/games/66fbb1cd-a9c6-416e-8ee3-215a7967907d/oliver-makeham-3d-environment"
            aria-label="Play Oliver Makeham's 3D environment game"
        >
            <span class="door-window" aria-hidden="true"></span>
            <img src="/jpg_game/door.png" alt="" loading="lazy" decoding="async" />
        </a>
    </main>
</Layout>

<style>
    :global(body) {
        background: #fff;
        color: #121411;
        font-family: Arial, Helvetica, sans-serif;
    }

    .game-page {
        box-sizing: border-box;
        max-width: 1360px;
        margin: 0 auto;
        padding: clamp(4.5rem, 8vw, 7rem) clamp(1rem, 4vw, 3.5rem) clamp(2.5rem, 5vw, 5rem);
    }

    .intro {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 0 auto clamp(2rem, 5vw, 4rem);
        max-width: 1120px;
    }

    .project-copy {
        max-width: 720px;
        margin: 0 auto clamp(2rem, 4vw, 3.5rem);
        font-size: clamp(1rem, 1.2vw, 1.2rem);
        line-height: 1.7;
    }

    .project-copy p + p {
        margin-top: 1.25rem;
    }

    h1 {
        min-width: 0;
        margin: 0;
        font-size: clamp(2.75rem, 8vw, 6.5rem);
        font-weight: 600;
        letter-spacing: -0.06em;
        line-height: 0.98;
    }

    .overview {
        max-width: 1120px;
        margin: 0 auto;
        overflow: hidden;
        background: #f4f1ea;
    }

    .overview--final {
        margin-top: 1rem;
    }

    .overview img {
        display: block;
        width: 100%;
        max-height: min(72svh, 52rem);
        aspect-ratio: 16 / 10;
        object-fit: contain;
    }

    .door-link {
        position: relative;
        display: block;
        width: min(100%, 34rem);
        aspect-ratio: 1;
        margin: 2rem auto 0;
        overflow: hidden;
    }

    .door-link img {
        position: relative;
        z-index: 1;
        display: block;
        width: 100%;
        height: 100%;
    }

    .door-window {
        position: absolute;
        top: 30.3%;
        left: 29.6%;
        width: 40.7%;
        height: 12.3%;
        background: #000;
        transition: box-shadow 300ms ease;
    }

    .door-window::after {
        position: absolute;
        inset: 0;
        background: radial-gradient(
            ellipse at center,
            rgb(255 172 82 / 95%) 0%,
            rgb(255 113 0 / 78%) 42%,
            rgb(255 85 0 / 30%) 76%,
            transparent 100%
        );
        content: '';
        opacity: 0;
        transition: opacity 300ms ease;
    }

    .door-link:hover .door-window,
    .door-link:focus-visible .door-window {
        box-shadow: 0 0 0.75rem 0.25rem rgb(255 113 0 / 55%);
    }

    .door-link:hover .door-window::after,
    .door-link:focus-visible .door-window::after {
        opacity: 1;
    }

    .door-link:focus-visible {
        outline: 3px solid #ff7100;
        outline-offset: 3px;
    }

    .groups {
        display: grid;
        gap: clamp(1.5rem, 3vw, 2.75rem);
        max-width: 1120px;
        margin: clamp(1.5rem, 3vw, 2.5rem) auto;
    }

    .gallery {
        display: grid;
        gap: 0.25rem;
    }

    .gallery-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
        align-items: stretch;
        gap: clamp(0.5rem, 1.2vw, 1rem);
    }

    .tile {
        min-width: 0;
        margin: 0;
        overflow: hidden;
        aspect-ratio: 4 / 3;
        background: #f4f1ea;
    }

    .tile img {
        display: block;
        width: 100%;
        height: 100%;
        max-height: min(68svh, 48rem);
        object-fit: contain;
        transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1), opacity 300ms ease;
    }

    .tile:hover img {
        transform: scale(1.035);
    }

    @media (max-width: 760px) {
        .game-page {
            padding: 4rem 1rem 3rem;
        }

    }

    @media (prefers-reduced-motion: reduce) {
        .tile img {
            transition: none;
        }

        .door-window {
            transition: none;
        }

        .door-window::after {
            transition: none;
        }
    }
</style>
