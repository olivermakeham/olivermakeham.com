---
import ProjectShell from '../components/ProjectShell.astro';
import Fig from '../components/Fig.astro';

const alt = (n: number) => `Tactile map, design ${n}`;
---

<ProjectShell
    title="Tactile Maps"
    bg="#ffffff"
    ink="#000000"
    accent="#000000"
    class="maps"
>
    <section class="hero">
        <div class="hero-img">
            <Fig folder="maps" src="title.jpg" alt="Tactile Maps project title artwork" fill eager zoom={false} radius="0" sizes="100vw" widths={[960, 1440, 1920]} />
        </div>
        <div class="p-wrap hero-copy">
            <h1 class="p-title p-title--left">
                <span class="braille" aria-hidden="true">⠞⠁⠉⠞⠊⠇⠑</span>
                <span class="sans">Tactile Maps</span>
                <span class="braille" aria-hidden="true">⠍⠁⠏⠎</span>
                <span class="p-date">2025 – present</span>
            </h1>
        </div>
    </section>

    <section class="p-wrap">
        <div class="p-intro">
            <p class="p-intro-lead">For people with vision impairments, it can be difficult to use conventional maps to understand the layout of a site, especially when the majority of information is communicated through visual graphic design. I developed maps for existing and developing sites using shapes and symbols that are greatly distinct from one another when felt, and utilise dramatic black and white contrast to stand out to those with limited vision. This simplified design language removes any unnecessary features that would be distracting when engaging with touch, and exaggerates scale and proportion to clearly define structure.</p>
        </div>
    </section>

    <section class="p-wrap examples">
        <div class="examples-row">
            <div class="p-cell p-cell--stretch" style="--cell:1278/1161"><Fig folder="maps" src="eg1.png" alt="Tactile map example one" fill fit="contain" bg="#f3f3f3" sizes="(min-width: 1200px) 580px, 94vw" radius="0" /></div>
            <div class="p-cell p-cell--stretch" style="--cell:1615/1149"><Fig folder="maps" src="eg2.png" alt="Tactile map example two" fill fit="contain" bg="#f3f3f3" sizes="(min-width: 1200px) 740px, 94vw" radius="0" /></div>
        </div>
        <p class="p-caption">Graphic elements in black are raised to allow for tactile tracing.</p>
    </section>

    <section class="band">
        <div class="p-wrap band-inner">
            <Fig folder="maps" src="legend.jpg" alt="Tactile Maps symbol legend" ratio="1920/430" fit="contain" bg="#fff" sizes="(min-width: 1440px) 1330px, 94vw" widths={[960, 1440, 1920]} radius="0" />
            <p class="p-caption band-text">The elements are simple but are easily distinguished from one another when felt.</p>
        </div>
    </section>

    <section class="p-wrap series">
        <div class="series-grid">
            <div class="p-cell" style="--cell:3/2"><Fig folder="maps" src="m1.jpg" alt={alt(1)} fill sizes="(min-width: 1440px) 660px, (min-width: 900px) 47vw, 94vw" widths={[640, 960, 1440]} radius="0" /></div>
            <div class="p-cell" style="--cell:3/2"><Fig folder="maps" src="m2.jpg" alt={alt(2)} fill sizes="(min-width: 1440px) 660px, (min-width: 900px) 47vw, 94vw" widths={[640, 960, 1440]} radius="0" /></div>
            <div class="p-cell" style="--cell:3/2"><Fig folder="maps" src="m3.jpg" alt={alt(3)} fill sizes="(min-width: 1440px) 660px, (min-width: 900px) 47vw, 94vw" widths={[640, 960, 1440]} radius="0" /></div>
            <div class="p-cell" style="--cell:3/2"><Fig folder="maps" src="m4.jpg" alt={alt(4)} fill sizes="(min-width: 1440px) 660px, (min-width: 900px) 47vw, 94vw" widths={[640, 960, 1440]} radius="0" /></div>
            <div class="p-cell" style="--cell:3/2"><Fig folder="maps" src="m5.jpg" alt={alt(5)} fill sizes="(min-width: 1440px) 660px, (min-width: 900px) 47vw, 94vw" widths={[640, 960, 1440]} radius="0" /></div>
            <div class="p-cell" style="--cell:3/2"><Fig folder="maps" src="m6.jpg" alt={alt(6)} fill sizes="(min-width: 1440px) 660px, (min-width: 900px) 47vw, 94vw" widths={[640, 960, 1440]} radius="0" /></div>
        </div>
    </section>
</ProjectShell>

<style>
    :global(.maps) {
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    }
    .hero {
        position: relative;
        min-height: clamp(30rem, 62vw, 62rem);
        max-height: 100svh;
        overflow: hidden;
        display: flex;
        align-items: center;
    }

    .hero-img {
        position: absolute;
        inset: 0;
        -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 55%, transparent 100%);
        mask-image: linear-gradient(180deg, #000 0%, #000 55%, transparent 100%);
    }

    .hero-img::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, rgba(255, 255, 255, 0.88) 0%, rgba(255, 255, 255, 0.55) 45%, transparent 80%);
        pointer-events: none;
    }

    .hero-copy {
        position: relative;
        padding-bottom: 8%;
        z-index: 2;
    }

    .hero .p-title {
        padding-block: 0;
        font-size: clamp(3.4rem, 10vw, 8.5rem);
        gap: 0.12em;
    }

    .braille {
        font-family: 'Segoe UI Symbol', 'Apple Braille', 'DejaVu Sans', sans-serif;
        font-size: 0.55em;
        font-weight: 400;
        line-height: 1;
        letter-spacing: 0.12em;
    }
    .examples {
        position: relative;
        display: grid;
        gap: var(--gap);
        padding-block: clamp(2rem, 5vw, 4rem);
    }

    .examples-row {
        display: grid;
        gap: var(--gap);
    }
    .band {
        margin-block: clamp(2rem, 5vw, 4rem);
        padding-block: clamp(2.5rem, 6vw, 5rem);
        color: #fff;
        background: #000;
    }

    .band-inner {
        display: grid;
        gap: clamp(1.5rem, 3vw, 2.5rem);
    }
    .band-inner :global(.fig) {
        border: clamp(8px, 1.1vw, 14px) solid #fff;
        padding: clamp(8px, 1.6vw, 24px);
    }

    .band-text {
        border-left-color: #fff;
    }

    .series {
        display: grid;
        gap: clamp(1.5rem, 3vw, 2.5rem);
        padding-block: clamp(2rem, 5vw, 4rem);
    }

    .series-grid {
        display: grid;
        gap: var(--gap);
    }

    @media (min-width: 700px) {
        .series-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (min-width: 900px) {
        .examples-row {
            grid-template-columns: 1fr 1.278fr;
            grid-auto-rows: clamp(18rem, 34vw, 31rem);
        }    }
</style>
