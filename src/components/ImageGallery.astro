---
import Layout from '../layouts/Layout.astro';

interface ImageItem {
    src: string;
    alt: string;
}

type Block =
    | { type: 'text'; text: string }
    | { type: 'heading'; text: string }
    | { type: 'image'; image: ImageItem }
    | { type: 'gallery'; images: ImageItem[]; label?: string };

interface Props {
    title: string;
    folder: string;
    blocks?: Block[];
}

const { title, folder, blocks = [] } = Astro.props;

const assetPath = (src: string) => `/jpg_${folder}/${src}`;
const filenameFamily = (src: string) => {
    const filename = src.split('/').pop() ?? src;
    const stem = filename.replace(/\.[^.]+$/, '');
    const family = stem
        .replace(/(?:[_\s-]*(?:bright|full|dim))$/i, '')
        .replace(/(?:[_\s-]*\d+)$/, '')
        .replace(/[_\s-]+/g, ' ')
        .trim();
    return (family || stem).toLowerCase();
};
const groupByFilename = (images: ImageItem[]) => {
    const groups: { family: string; images: ImageItem[] }[] = [];

    for (const image of images) {
        const family = filenameFamily(image.src);
        const previousGroup = groups[groups.length - 1];

        if (previousGroup?.family === family) {
            previousGroup.images.push(image);
        } else {
            groups.push({ family, images: [image] });
        }
    }

    return groups;
};
---

<Layout title={`${title} — Oliver Makeham`}>
    <main class="project-page">
        <header class="intro">
            <h1>{title}</h1>
        </header>

        <div class="sequence">
            {blocks.map((block) => {
                if (block.type === 'text') {
                    return <p class="project-copy">{block.text}</p>;
                }

                if (block.type === 'heading') {
                    return <h2>{block.text}</h2>;
                }

                if (block.type === 'image') {
                    return (
                        <figure class="feature-image">
                            <img
                                src={assetPath(block.image.src)}
                                alt={block.image.alt}
                                loading="lazy"
                                decoding="async"
                            />
                        </figure>
                    );
                }

                return (
                    <>
                        {groupByFilename(block.images).map((group) => (
                            <section
                                class:list={['gallery', group.images.length === 1 && 'gallery--single']}
                                aria-label={`${block.label ?? `${title} image sequence`} — ${group.family}`}
                            >
                                {group.images.map((image) => (
                                    <figure class="tile">
                                        <img
                                            src={assetPath(image.src)}
                                            alt={image.alt}
                                            loading="lazy"
                                            decoding="async"
                                        />
                                    </figure>
                                ))}
                            </section>
                        ))}
                    </>
                );
            })}
        </div>
    </main>
</Layout>

<style>
    :global(body) {
        background: #fff;
        color: #121411;
        font-family: Arial, Helvetica, sans-serif;
    }

    .project-page {
        box-sizing: border-box;
        max-width: 1360px;
        margin: 0 auto;
        padding: clamp(4.5rem, 8vw, 7rem) clamp(1rem, 4vw, 3.5rem) clamp(2.5rem, 5vw, 5rem);
    }

    .intro {
        max-width: 1120px;
        margin: 0 auto clamp(2rem, 5vw, 4rem);
    }

    h1 {
        margin: 0;
        font-size: clamp(2.75rem, 8vw, 6.5rem);
        font-weight: 600;
        letter-spacing: -0.06em;
        line-height: 0.98;
    }

    .sequence {
        display: grid;
        gap: clamp(1.5rem, 3vw, 2.75rem);
    }

    .project-copy {
        max-width: 720px;
        margin: clamp(0.5rem, 1vw, 1rem) auto;
        font-size: clamp(1rem, 1.2vw, 1.2rem);
        line-height: 1.7;
    }

    h2 {
        max-width: 1120px;
        width: 100%;
        margin: clamp(1.5rem, 4vw, 3rem) auto 0;
        font-size: clamp(1.75rem, 4.5vw, 3.5rem);
        font-weight: 500;
        letter-spacing: -0.045em;
        line-height: 1;
    }

    .feature-image,
    .tile {
        min-width: 0;
        margin: 0;
        overflow: hidden;
        background: #f4f1ea;
    }

    .feature-image img,
    .tile img {
        display: block;
        width: 100%;
        height: 100%;
        max-height: min(72svh, 52rem);
        object-fit: contain;
        transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    .feature-image {
        width: 100%;
        max-width: 1120px;
        max-height: min(72svh, 52rem);
        aspect-ratio: 16 / 10;
        margin: 0 auto;
    }

    .feature-image:hover img,
    .tile:hover img {
        transform: scale(1.02);
    }

    .gallery {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        align-items: stretch;
        gap: clamp(0.5rem, 1.2vw, 1rem);
        max-width: 1120px;
        width: 100%;
        margin: 0 auto;
    }

    .gallery--single {
        grid-template-columns: minmax(0, 1fr);
        max-width: 1000px;
    }

    .tile {
        aspect-ratio: 4 / 3;
    }

    @media (max-width: 760px) {
        .project-page {
            padding: 4rem 1rem 3rem;
        }

        .intro {
            margin-bottom: 2rem;
        }

        .gallery {
            grid-template-columns: minmax(0, 1fr);
        }

        .tile {
            aspect-ratio: 4 / 3;
        }

        .feature-image,
        .gallery--single .tile {
            aspect-ratio: 4 / 3;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .feature-image img,
        .tile img {
            transition: none;
        }
    }
</style>
