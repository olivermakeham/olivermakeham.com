---
import '@fontsource/eb-garamond/latin-700-italic.css';
import '@fontsource/eb-garamond/latin-400-italic.css';
import CardHand from '../components/CardHand.astro';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHomePage = currentPath === '/';
import Lightbox from '../components/Lightbox.astro';

const { title = 'Oliver Makeham', bg, ink, lightbox = false } = Astro.props;
const themeStyle = bg ? `background:${bg};--ink:${ink ?? '#121411'};--page-bg:${bg}` : undefined;
---
<!doctype html>
<html lang="en" style={bg ? `background:${bg}` : undefined}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/Untitled2.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
			document.documentElement.classList.add('js');
			try {
				if (localStorage.getItem('motion') === 'off') document.documentElement.classList.add('no-motion');
			} catch {}
		</script>
		<slot name="head" />
	</head>
	<body style={themeStyle} class:list={[!isHomePage && 'has-hand']}>
		<slot />
		{lightbox && <Lightbox />}
		{!isHomePage && <CardHand current={currentPath} />}
		<script>
			import '../scripts/motion-toggle.ts';
		</script>
	</body>
</html>

<style is:global>
	/* Motion off: nothing animates; hover states still change, just instantly */
	html.no-motion *,
	html.no-motion *::before,
	html.no-motion *::after {
		animation: none !important;
		transition: none !important;
		scroll-behavior: auto !important;
	}
</style>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	/* Room for the resting card hand so it never covers page content */
	body.has-hand {
		--hand-h: 3.8rem;
		box-sizing: border-box;
		height: auto;
		min-height: 100%;
		padding-bottom: var(--hand-h);
	}
</style>
